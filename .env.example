# Server
WHATIF_HOST=127.0.0.1
WHATIF_PORT=3000
WHATIF_DATA=./data
# Require this token on every /api call (?token=... or x-whatif-token). Empty = no auth (localhost only).
WHATIF_AUTH_TOKEN=

# The skill folder (studio/, scripts/, references/). Auto-detected when the repo sits next to this one.
WHATIF_SKILL_DIR=

# Model: mock | openai | openrouter | google | anthropic | mistral | groq | local
WHATIF_PROVIDER=mock
WHATIF_BASE_URL=
WHATIF_MODEL=
WHATIF_API_KEY=

# --- Reviewer indépendant (audit automatique du storyboard & cohérence du récit) ------
# Active un second agent Reviewer au contexte vierge après l'étape "board" pour auditer
# la cohérence DIRECTOR.md <-> shots.tsx <-> storyboard.jpg (conseillé : un modèle vision).
# Si laissé vide et WHATIF_REVIEWER_ENABLED=true, réutilise le provider/clé principal.
WHATIF_REVIEWER_ENABLED=true
WHATIF_REVIEW_PROVIDER=
WHATIF_REVIEW_BASE_URL=
WHATIF_REVIEW_MODEL=
WHATIF_REVIEW_API_KEY=
# Nombre maximum d'allers-retours de correction par épisode avant de continuer vers render/master.
WHATIF_REVIEW_MAX_ROUNDS=2
WHATIF_REVIEW_MAX_TOKENS=4000

# ElevenLabs: utilisé pour les SFX (ou en direct), tandis que la voix TTS passe par :8005 (eleven_v4 Hugo/Léa).
ELEVENLABS_API_KEY=

# Agent limits
# Output tokens per model call. Reasoning/Flash models think out of this budget first:
# too low and they return an empty message with finish_reason "length".
WHATIF_MAX_TOKENS=24000
WHATIF_MAX_STEPS=1000
WHATIF_CONTEXT_CHARS=90000
WHATIF_APPROVAL_TIMEOUT_MS=1800000

# --- Rendu (Modal) -------------------------------------------------------------------
# "modal" (défaut) déporte les rendus, "local" utilise npx remotion dans ce conteneur.
WHATIF_RENDER=modal
# Secrets Modal : soit ici, soit dans ~/.modal.toml (monté dans le conteneur).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Nom de l'app Modal et taille de la fonction (8 vCPU / 12 Go par défaut).
WHATIF_MODAL_APP=whatif-app-render
WHATIF_MODAL_VCPU=8
WHATIF_MODAL_MEMORY_MIB=12288

# --- API locale "nouveau" (transcription, narration FR, TTS Fish) ---------------------
# Le service sur le port 8005 ; il garde les vidéos, les prises TTS et les propositions.
WHATIF_NOUVEAU_URL=http://127.0.0.1:8005
# Modèle qui écrit les propositions de narration française. Vide = le défaut de nouveau, qui peut être
# un nom de modèle absent du compte (on obtient alors "Aucune proposition générée").
WHATIF_NARRATION_MODEL=agy/gemini-3.8-flash-medium

# --- Approbations ---------------------------------------------------------------------
# off      : l'agent exécute toute la chaîne (source -> master) sans rien demander. Défaut.
# pipeline : il demande avant les outils qui modifient un projet (whatif_new, whatif_run, shell).
# all      : il demande pour tout outil marqué "ask".
WHATIF_APPROVALS=off
